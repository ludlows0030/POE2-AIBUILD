# ── Project ──────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=poe2bd
POSTGRES_PASSWORD=poe2bd_dev
POSTGRES_DB=poe2bd

# ── Neo4j ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=poe2bd_dev
NEO4J_DATABASE=neo4j

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Qdrant ───────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=

# ── Celery ───────────────────────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── GGG API (POE2) ───────────────────────────────────
GGG_API_BASE_URL=https://www.pathofexile.com/api
GGG_WEB_BASE_URL=https://www.pathofexile.com
GGG_TRADE_API_URL=https://www.pathofexile.com/api/trade
GGG_RATE_LIMIT_PER_MIN=45
GGG_USER_AGENT=POE2BD-Agent/1.0 (contact: dev@example.com)
GGG_POESESSID=
GGG_DEFAULT_LEAGUE=Standard
GGG_REALM=Poe2

# OAuth 2.1 凭证 — 需向 oauth@grindinggear.com 注册应用
# GGG_OAUTH_CLIENT_ID=
# GGG_OAUTH_CLIENT_SECRET=
# GGG_OAUTH_ACCESS_TOKEN=
GGG_OAUTH_SCOPE=account:characters service:leagues service:leagues:ladder

# ── Community Data Sources ───────────────────────────
POEDB_BASE_URL=https://poedb.tw
POBB_IN_API_URL=https://pobb.in/api

# ── LLM / Anthropic ──────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── Collection Schedule (hours) ──────────────────────
COLLECT_LADDER_INTERVAL_HOURS=168
COLLECT_CHARACTER_INTERVAL_HOURS=168
COLLECT_MECHANICS_INTERVAL_HOURS=168

# ── Build Generation ─────────────────────────────────
MAX_REFERENCE_BUILDS=5
BUILD_CONFIDENCE_THRESHOLD=0.6
